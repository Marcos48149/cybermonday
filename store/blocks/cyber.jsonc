    "children": [
      "flex-layout.col#cm26-promo-1",
      "flex-layout.col#cm26-promo-2",
      "flex-layout.col#cm26-promo-3",
      "flex-layout.col#cm26-promo-4"
    ]
  },
  "flex-layout.col#cm26-promo-1": {
    "props": { "width": "25%", "blockClass": "cyber-promo-col" },
    "children": ["image#cm26-promo-1"]
  },
  "flex-layout.col#cm26-promo-2": {
    "props": { "width": "25%", "blockClass": "cyber-promo-col" },
    "children": ["image#cm26-promo-2"]
  },
  "flex-layout.col#cm26-promo-3": {
