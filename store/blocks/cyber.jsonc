      "alt": "Cyber Show",
      "link": { "url": "/cybermonday" },
      "maxWidth": "100%",
      "blockClass": "cyber-side-img"
    }
  },

  /* --- SECCIÓN 2 --- */
  "flex-layout.row#cm26-sec-2": {
    "props": { "blockClass": "cyber-section", "preserveLayoutOnMobile": false, "colGap": 4, "fullWidth": true },
    "children": ["flex-layout.col#cm26-sec-2-banner", "flex-layout.col#cm26-sec-2-products"]
  },
  "flex-layout.col#cm26-sec-2-banner": {
    "props": { "width": "22%", "blockClass": "cyber-side" },
    "children": ["image#cm26-side-2"]
  },
  "flex-layout.col#cm26-sec-2-products": {
    "props": { "width": "78%", "blockClass": "cyber-products-col" },
    "children": ["cyber-product-list#cm26-cyber-2"]
  },
  "image#cm26-side-2": {
    "props": {
      "src": "https://showsport.vtexassets.com/assets/vtex.file-manager-graphql/images/e50cb14f-472e-4d96-8642-e716cc825a9e___4c85efb2fd94e4c4f52e30733df74302.gif",
      "mobileImage": "https://showsport.vtexassets.com/assets/vtex.file-manager-graphql/images/e50cb14f-472e-4d96-8642-e716cc825a9e___4c85efb2fd94e4c4f52e30733df74302.gif",
      "alt": "Cyber Show",
      "link": { "url": "/cybermonday" },
      "maxWidth": "100%",
      "blockClass": "cyber-side-img"
    }
  },

  /* --- 4 BANNERS DE PROMOCIONES --- */
  "flex-layout.row#cm26-cyber-promos": {
