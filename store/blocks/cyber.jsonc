    "children": ["image#cm26-promo-4"]
  },
  "image#cm26-promo-1": {
    "props": {
      "src": "https://showsport.vtexassets.com/assets/vtex.file-manager-graphql/images/e287ecac-8f08-4aa7-a0e9-c4ad9a6c1ffb___f5f4149cfeebf4ac49aecff0fe7dfb55.gif",
