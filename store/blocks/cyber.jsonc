  /* --- FRANJA FINAL (COLECCIÓN COMPLETA) --- */
  
  "link#cm26-cyber-final-banners-link": {
    "props": {
      "href": "/544?map=productClusterIds",
      "blockClass": "cyber-strip-final-link"
    },
    "children": [
      "flex-layout.row#cm26-cyber-final-banners"
    ]
  },

  "flex-layout.row#cm26-cyber-final-banners": {
    "props": {
      "blockClass": ["cyber-strip", "cyber-strip-final"],
      "fullWidth": true,
      "horizontalAlign": "center",
      "verticalAlign": "middle",
      "preserveLayoutOnMobile": true
    },
    "children": ["rich-text#cm26-final-banner-1"]
  },
  
  "rich-text#cm26-final-banner-1": {
    "props": {
      "text": "¡COLECCIÓN COMPLETA!",
      "textAlignment": "CENTER",
      "blockClass": "cyber-strip"
    }
  },

  /* --- SECCIÓN 3 --- */
  "flex-layout.row#cm26-sec-3": {
    "props": { "blockClass": "cyber-section", "preserveLayoutOnMobile": false, "colGap": 4, "fullWidth": true },
    "children": ["flex-layout.col#cm26-sec-3-banner", "flex-layout.col#cm26-sec-3-products"]
  },
  "flex-layout.col#cm26-sec-3-banner": {
    "props": { "width": "22%", "blockClass": "cyber-side" },
    "children": ["image#cm26-side-3"]
  },
  "flex-layout.col#cm26-sec-3-products": {
    "props": { "width": "78%", "blockClass": "cyber-products-col" },
    "children": ["cyber-product-list#cm26-cyber-3"]
  },
  "image#cm26-side-3": {
    "props": {
      "src": "https://showsport.vtexassets.com/assets/vtex.file-manager-graphql/images/641b7f07-b67d-4154-b88d-d2d46b3a6b38___b18b7f650b6ff5bf191fd0469c063423.gif",
      "mobileImage": "https://showsport.vtexassets.com/assets/vtex.file-manager-graphql/images/641b7f07-b67d-4154-b88d-d2d46b3a6b38___b18b7f650b6ff5bf191fd0469c063423.gif",
      "alt": "Cyber Show",
      "link": { "url": "/cybermonday" },
      "maxWidth": "100%",
      "blockClass": "cyber-side-img"
    }
  },

  /* --- LISTAS DE PRODUCTOS Y CARRUSEL --- */
  "cyber-product-list#cm26-cyber-1": {
    "blocks": ["product-summary.shelf#cm26-cyber"],
    "props": {
      "collection": "542",
      "orderBy": "OrderByTopSaleDESC",
      "hideUnavailableItems": true,
      "maxItems": 16
    },
    "children": ["slider-layout#cm26-cyber-products"]
  },
  "cyber-product-list#cm26-cyber-2": {
    "blocks": ["product-summary.shelf#cm26-cyber"],
    "props": {
      "collection": "543",
      "orderBy": "OrderByTopSaleDESC",
      "hideUnavailableItems": true,
      "maxItems": 16
    },
    "children": ["slider-layout#cm26-cyber-products"]
  },
  "cyber-product-list#cm26-cyber-3": {
    "blocks": ["product-summary.shelf#cm26-cyber"],
    "props": {
      "collection": "544",
      "orderBy": "OrderByTopSaleDESC",
      "hideUnavailableItems": true,
      "maxItems": 16
    },
    "children": ["slider-layout#cm26-cyber-products"]
  },

  "slider-layout#cm26-cyber-products": {
    "props": {
      "itemsPerPage": { "desktop": 3, "tablet": 2, "phone": 2 },
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "mobileOnly",
      "fullWidth": false,
      "blockClass": "cyber-products"
    }
  },

  "product-summary.shelf#cm26-cyber": {
    "children": [
      "product-summary-image#cm26-cyber",
      "product-summary-name#cm26-cyber",
      "product-summary-price#cm26-cyber"
    ]
  },
  "product-summary-image#cm26-cyber": {
    "props": { "showBadge": true, "aspectRatio": "1:1", "maxHeight": 300 }
  },
  "product-summary-name#cm26-cyber": {
    "props": { "showBrandName": true }
  },
  "product-summary-price#cm26-cyber": {
    "props": { "showListPrice": true, "showLabels": false, "showInstallments": true }
  }
}